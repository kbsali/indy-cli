{
  "name": "@kbsali/indy-cli",
  "version": "0.1.0",
  "description": "CLI for the unofficial Indy web API: list/filter transactions, upload receipts, edit VAT",
  "keywords": [
    "accounting",
    "bun",
    "cli",
    "comptabilite",
    "indy",
    "tva",
    "vat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kbsali/indy-cli.git"
  },
  "bin": {
    "indy": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "check": "oxlint && bun fmt --check && bun check",
    "fix": "oxlint --fix && bun fmt",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
